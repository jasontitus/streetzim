# web/drive/viewer/ and web/drive/fzstd.js are populated by
# scripts/sync-drive-viewer.sh. We commit them (rather than generating
# on deploy) so a plain `firebase deploy` works without relying on
# predeploy hooks, and so cloning the repo gives a runnable PWA.
# Re-run scripts/sync-drive-viewer.sh after changing resources/viewer/
# or bumping the MapLibre / fzstd versions.
overture_cache/

# Cache-dir symlinks in worktrees (pointed at main tree)
/satellite_cache_avif_256
/search_cache
/terrain_cache
/wikidata_cache
/world-data
/silicon-valley-overture.log

# Node deps for the puppeteer-based routing harness.
/node_modules/

# Build / deploy noise (logs from build_region.sh, rollout scripts,
# and ad-hoc retry runs). We don't review these.
/*.log
/.preflight-corrupt-tiles.txt
/3
/boundary_chunk_*.txt
/.firebase/

# Rust build outputs (streetzim-pack — the zimru-backed manifest packer).
# Source lives under rust/, we don't commit `target/` artifacts.
/rust/**/target/

# Operational noise from build/rollout runs (2026-09-21). These are run
# artefacts, not sources: regenerating them is the normal path, and 1,100+
# of them made `git status` unreadable enough to hide real changes -- an
# untracked runtime dependency (web/drive/wiki-qid-titles.json) sat
# unnoticed in that list until a deploy would have 404'd on it.
*.out
*.log
tmp/*.txt
tmp/*.json
tmp/*.zst
tmp/*.bin
*.pid
*.lock
*.bak-*
*.patch
rejected-zims/
salvage/
/cache/natural-earth/
